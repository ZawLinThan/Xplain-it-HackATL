{
  "openapi": "3.1.0",
  "info": {
    "title": "vDemo API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/config": {
      "get": {
        "tags": [
          "sessions",
          "config"
        ],
        "summary": "Get Config",
        "description": "Lets the front end label canned (Simulated) output honestly in demo mode.",
        "operationId": "get_config_api_v1_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Create Session",
        "description": "Start a session from the preloaded sample assessment and write the three questions.",
        "operationId": "create_session_api_v1_sessions_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/questions/{n}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Get Question",
        "description": "Return question n and start its timer the first time it is asked for.",
        "operationId": "get_question_api_v1_sessions__session_id__questions__n__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "N"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionPublic"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/questions/{n}/answer": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Submit Answer",
        "operationId": "submit_answer_api_v1_sessions__session_id__questions__n__answer_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "N"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_submit_answer_api_v1_sessions__session_id__questions__n__answer_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/report": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Get Report",
        "description": "Grade the three answers (one LLM call), save the scores and return the report.",
        "operationId": "get_report_api_v1_sessions__session_id__report_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerResult": {
        "properties": {
          "transcript": {
            "type": "string",
            "title": "Transcript"
          },
          "seconds_used": {
            "type": "number",
            "title": "Seconds Used"
          },
          "late": {
            "type": "boolean",
            "title": "Late"
          }
        },
        "type": "object",
        "required": [
          "transcript",
          "seconds_used",
          "late"
        ],
        "title": "AnswerResult"
      },
      "AppConfig": {
        "properties": {
          "demo_mode": {
            "type": "boolean",
            "title": "Demo Mode",
            "description": "True when the server returns canned LLM output and transcripts (DEMO_MODE=1)"
          }
        },
        "type": "object",
        "required": [
          "demo_mode"
        ],
        "title": "AppConfig"
      },
      "Body_submit_answer_api_v1_sessions__session_id__questions__n__answer_post": {
        "properties": {
          "audio": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Audio"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "default": false
          },
          "video": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video"
          }
        },
        "type": "object",
        "required": [
          "audio"
        ],
        "title": "Body_submit_answer_api_v1_sessions__session_id__questions__n__answer_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuestionPublic": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index",
            "description": "1-based position of the question"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "max_seconds": {
            "type": "integer",
            "title": "Max Seconds"
          }
        },
        "type": "object",
        "required": [
          "index",
          "total",
          "text",
          "max_seconds"
        ],
        "title": "QuestionPublic"
      },
      "QuestionResult": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "transcript": {
            "type": "string",
            "title": "Transcript"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score",
            "description": "Integer 0 to 5, or null when not graded yet"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback"
          }
        },
        "type": "object",
        "required": [
          "index",
          "text",
          "transcript",
          "score",
          "feedback"
        ],
        "title": "QuestionResult"
      },
      "Report": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "problem_score": {
            "type": "number",
            "title": "Problem Score",
            "description": "P, 0 to 1. Preset in this demo, never set by an LLM"
          },
          "explanation_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation Score",
            "description": "E, 0 to 1, or null when partial"
          },
          "final_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Score",
            "description": "0 to 100, or null when partial"
          },
          "review_flag": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Flag",
            "description": "True when P - E is over the threshold. A prompt for a human, never a verdict"
          },
          "partial": {
            "type": "boolean",
            "title": "Partial",
            "description": "True when some answers could not be graded"
          },
          "weights": {
            "$ref": "#/components/schemas/Weights"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/QuestionResult"
            },
            "type": "array",
            "title": "Questions"
          }
        },
        "type": "object",
        "required": [
          "title",
          "problem_score",
          "explanation_score",
          "final_score",
          "review_flag",
          "partial",
          "weights",
          "questions"
        ],
        "title": "Report"
      },
      "SessionCreated": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "total_questions": {
            "type": "integer",
            "title": "Total Questions",
            "default": 3
          },
          "max_answer_seconds": {
            "type": "integer",
            "title": "Max Answer Seconds",
            "default": 40
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "title"
        ],
        "title": "SessionCreated"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Weights": {
        "properties": {
          "problem": {
            "type": "number",
            "title": "Problem"
          },
          "explanation": {
            "type": "number",
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "problem",
          "explanation"
        ],
        "title": "Weights"
      }
    }
  }
}
