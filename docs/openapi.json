{
  "openapi": "3.1.0",
  "info": {
    "title": "vDemo API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/config": {
      "get": {
        "tags": [
          "sessions",
          "config"
        ],
        "summary": "Get Config",
        "description": "Lets the front end label canned (Simulated) output honestly in demo mode.",
        "operationId": "get_config_api_v1_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Create Session",
        "description": "Start a session and write the three questions.\n\nUses the preloaded sample assessment, or the student's uploaded file content when an\n`upload_id` is given. The problem score P is always the preset\none in this demo: no code is run.",
        "operationId": "create_session_api_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SessionStart"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/questions/{n}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Get Question",
        "description": "Return question n and start its timer the first time it is asked for.",
        "operationId": "get_question_api_v1_sessions__session_id__questions__n__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "N"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionPublic"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/questions/{n}/answer": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Submit Answer",
        "operationId": "submit_answer_api_v1_sessions__session_id__questions__n__answer_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "N"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_submit_answer_api_v1_sessions__session_id__questions__n__answer_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/report": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Get Report",
        "description": "Grade the three answers (one LLM call), save the scores and return the report.",
        "operationId": "get_report_api_v1_sessions__session_id__report_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads": {
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Create Upload",
        "description": "Store the assessment questions file and the student's answer files.",
        "operationId": "create_upload_api_v1_uploads_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_upload_api_v1_uploads_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/professor/sessions": {
      "get": {
        "tags": [
          "professor"
        ],
        "summary": "List Sessions",
        "description": "Recent sessions with their flags. Needs the X-Professor-Token header.",
        "operationId": "list_sessions_api_v1_professor_sessions_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "x-professor-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Professor-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfessorSessions"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/professor/sessions/{session_id}": {
      "get": {
        "tags": [
          "professor"
        ],
        "summary": "Get Session",
        "operationId": "get_session_api_v1_professor_sessions__session_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "x-professor-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Professor-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfessorSession"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/voice/status": {
      "get": {
        "tags": [
          "voice verification"
        ],
        "summary": "Status",
        "operationId": "status_api_v1_voice_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/voice/enroll": {
      "post": {
        "tags": [
          "voice verification"
        ],
        "summary": "Enroll",
        "operationId": "enroll_api_v1_voice_enroll_post",
        "parameters": [
          {
            "name": "consent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Consent"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "contentMediaType": "application/octet-stream",
                "maxLength": 640000,
                "title": "Pcm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceEnrollment"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}/questions/{n}/voice-check": {
      "post": {
        "tags": [
          "voice verification"
        ],
        "summary": "Check",
        "operationId": "check_api_v1_sessions__session_id__questions__n__voice_check_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "N"
            }
          },
          {
            "name": "sequence",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "title": "Sequence"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "contentMediaType": "application/octet-stream",
                "maxLength": 128000,
                "title": "Pcm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceCheckResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerResult": {
        "properties": {
          "transcript": {
            "type": "string",
            "title": "Transcript"
          },
          "seconds_used": {
            "type": "number",
            "title": "Seconds Used"
          },
          "late": {
            "type": "boolean",
            "title": "Late"
          }
        },
        "type": "object",
        "required": [
          "transcript",
          "seconds_used",
          "late"
        ],
        "title": "AnswerResult"
      },
      "AppConfig": {
        "properties": {
          "demo_mode": {
            "type": "boolean",
            "title": "Demo Mode",
            "description": "True when the server returns canned LLM output and transcripts (DEMO_MODE=1)"
          },
          "gaze_tracking": {
            "type": "boolean",
            "title": "Gaze Tracking",
            "description": "False turns the look-away detector off (GAZE_TRACKING=0)"
          },
          "debug_borders": {
            "type": "boolean",
            "title": "Debug Borders",
            "description": "Developer toggle (DEBUG_BORDERS=1): the front end draws the red look-away borders"
          }
        },
        "type": "object",
        "required": [
          "demo_mode",
          "gaze_tracking",
          "debug_borders"
        ],
        "title": "AppConfig"
      },
      "Body_create_upload_api_v1_uploads_post": {
        "properties": {
          "questions_file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Questions File"
          },
          "answers_file": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Answers File"
          }
        },
        "type": "object",
        "required": [
          "questions_file",
          "answers_file"
        ],
        "title": "Body_create_upload_api_v1_uploads_post"
      },
      "Body_submit_answer_api_v1_sessions__session_id__questions__n__answer_post": {
        "properties": {
          "audio": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Audio"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "default": false
          },
          "video": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video"
          },
          "lookaway": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lookaway"
          }
        },
        "type": "object",
        "required": [
          "audio"
        ],
        "title": "Body_submit_answer_api_v1_sessions__session_id__questions__n__answer_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LookawayDuration": {
        "properties": {
          "t_ms": {
            "maximum": 60000,
            "minimum": 0,
            "title": "T Ms",
            "type": "integer"
          },
          "duration_ms": {
            "maximum": 60000,
            "minimum": 0,
            "title": "Duration Ms",
            "type": "integer"
          },
          "side": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ],
            "title": "Side",
            "type": "string"
          }
        },
        "required": [
          "t_ms",
          "duration_ms",
          "side"
        ],
        "title": "LookawayDuration",
        "type": "object"
      },
      "LookawayEvent": {
        "properties": {
          "t_ms": {
            "maximum": 60000,
            "minimum": 0,
            "title": "T Ms",
            "type": "integer"
          },
          "side": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom",
              "lost"
            ],
            "title": "Side",
            "type": "string"
          }
        },
        "required": [
          "t_ms",
          "side"
        ],
        "title": "LookawayEvent",
        "type": "object"
      },
      "ProfessorLookaway": {
        "properties": {
          "tracked": {
            "type": "boolean",
            "title": "Tracked"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "flagged": {
            "type": "boolean",
            "title": "Flagged"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/LookawayEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "duration_log": {
            "items": {
              "$ref": "#/components/schemas/LookawayDuration"
            },
            "type": "array",
            "title": "Duration Log"
          }
        },
        "type": "object",
        "required": [
          "tracked",
          "count",
          "flagged",
          "events"
        ],
        "title": "ProfessorLookaway"
      },
      "ProfessorQuestion": {
        "properties": {
          "voice_flags": {
            "items": {
              "$ref": "#/components/schemas/VoiceFlag"
            },
            "type": "array",
            "title": "Voice Flags"
          },
          "n": {
            "type": "integer",
            "title": "N"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "answered": {
            "type": "boolean",
            "title": "Answered"
          },
          "transcript": {
            "type": "string",
            "title": "Transcript"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "late": {
            "type": "boolean",
            "title": "Late"
          },
          "seconds_used": {
            "type": "number",
            "title": "Seconds Used"
          },
          "lookaway": {
            "$ref": "#/components/schemas/ProfessorLookaway"
          }
        },
        "type": "object",
        "required": [
          "n",
          "text",
          "answered",
          "transcript",
          "score",
          "late",
          "seconds_used",
          "lookaway"
        ],
        "title": "ProfessorQuestion"
      },
      "ProfessorSession": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "problem_score": {
            "type": "number",
            "title": "Problem Score"
          },
          "explanation_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation Score"
          },
          "final_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Score"
          },
          "gap": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gap"
          },
          "review_flag": {
            "type": "boolean",
            "title": "Review Flag"
          },
          "review_threshold": {
            "type": "number",
            "title": "Review Threshold"
          },
          "lookaway_threshold": {
            "type": "integer",
            "title": "Lookaway Threshold"
          },
          "lookaway_flagged": {
            "type": "boolean",
            "title": "Lookaway Flagged"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/ProfessorQuestion"
            },
            "type": "array",
            "title": "Questions"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "created_at",
          "title",
          "problem_score",
          "explanation_score",
          "final_score",
          "gap",
          "review_flag",
          "review_threshold",
          "lookaway_threshold",
          "lookaway_flagged",
          "questions"
        ],
        "title": "ProfessorSession"
      },
      "ProfessorSessionRow": {
        "properties": {
          "voice_flagged": {
            "type": "boolean",
            "title": "Voice Flagged",
            "default": false
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "answered": {
            "type": "integer",
            "title": "Answered"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed"
          },
          "final_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Score"
          },
          "review_flag": {
            "type": "boolean",
            "title": "Review Flag"
          },
          "lookaway_flagged": {
            "type": "boolean",
            "title": "Lookaway Flagged"
          },
          "lookaway_tracked_all": {
            "type": "boolean",
            "title": "Lookaway Tracked All"
          },
          "lookaway_max": {
            "type": "integer",
            "title": "Lookaway Max",
            "description": "Most look-aways in any one question"
          },
          "lookaway_max_question": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lookaway Max Question",
            "description": "Which question had the most"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "created_at",
          "title",
          "answered",
          "completed",
          "final_score",
          "review_flag",
          "lookaway_flagged",
          "lookaway_tracked_all",
          "lookaway_max",
          "lookaway_max_question"
        ],
        "title": "ProfessorSessionRow"
      },
      "ProfessorSessions": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/ProfessorSessionRow"
            },
            "type": "array",
            "title": "Sessions"
          },
          "lookaway_threshold": {
            "type": "integer",
            "title": "Lookaway Threshold"
          }
        },
