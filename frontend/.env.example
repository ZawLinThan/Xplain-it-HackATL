# Where the backend runs (default http://localhost:8000)
VITE_API_URL=http://localhost:8000
# Scripted look-aways per answer for demos and tests (needs no camera model). Empty = the real detector.
VITE_FAKE_GAZE=
# 1 = use canned data from src/api/mocks (no backend needed). Try ?mock=weak or ?mock=partial in the URL.
VITE_MOCK=0
