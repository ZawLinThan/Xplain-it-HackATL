CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM and speech to text (free Groq key: https://console.groq.com) ---
# Leave GROQ_API_KEY empty to run with the stored question bank and no grading.
GROQ_API_KEY=
# groq | demo | fake | none   (default: groq when a key exists, otherwise none)
LLM_PROVIDER=
LLM_MODEL=openai/gpt-oss-20b
# groq | local | demo | fake | none
STT_PROVIDER=
STT_MODEL=whisper-large-v3-turbo
# local Whisper (pip install faster-whisper)
WHISPER_MODEL=base.en

# --- Scoring ---
WP=0.6
WE=0.4
REVIEW_THRESHOLD=0.40
# seconds allowed on top of 40 s for reading the question, pressing record and uploading
ANSWER_GRACE_SECONDS=30

# --- Storage and privacy ---
DATABASE_PATH=vdemo.db
# Audio is deleted after transcription unless this is 1
RETAIN_AUDIO=0
RETAIN_VIDEO=0
AUDIO_DIR=audio
SESSION_TTL_HOURS=24

# --- Uploads, look-away detector and instructor view ---
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152
# a question's recording is flagged for the instructor at this many look-aways
LOOKAWAY_THRESHOLD=4
# 0 turns the look-away detector off for everyone
GAZE_TRACKING=1
# developer toggle: 1 makes the front end draw the red look-away borders and a gaze dot
DEBUG_BORDERS=0
# shared token for /api/v1/professor/*. Empty = those routes return 404 (DEMO_MODE falls back to "demo")
PROFESSOR_TOKEN=

# 1 = offline demo: canned LLM output and canned transcripts (no keys needed)
DEMO_MODE=0
# strong | weak: which canned student DEMO_MODE plays
DEMO_STUDENT=strong

# Question narration (server only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XZXyuzPdidXaSa10PmVA
ELEVENLABS_MODEL_ID=eleven_v4
